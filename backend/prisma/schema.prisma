// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client" // or `prisma-client-js`
  output     = "../src/generated/prisma"
  engineType = "client" // enable Prisma ORM without Rust
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String // hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  extra     Json?    @default("{}")
}

model Video {
  id                  String    @id @default(cuid())
  title               String
  channel_id          String
  short_description   String?
  duration            Int       @default(0)
  view_count          Int       @default(0)
  type                String    @default("video")
  keywords            String[]  @default([])
  like_count          Int       @default(0)
  category            String?
  captions            Caption[]
  heatmap             Json?     @default("[]")
  extra               Json?     @default("{}")
  last_manual_fetch   DateTime  @default(now())
  available_qualities String[]  @default([])
  thumbnails          Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  creator Creator @relation(fields: [channel_id], references: [id])

  nextEdges VideoNext[] @relation("FromVideo")
  prevEdges VideoNext[] @relation("ToVideo")
}

model VideoNext {
  fromId String
  toId   String

  position  Int?
  extra     Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from Video @relation("FromVideo", fields: [fromId], references: [id], onDelete: Cascade)
  to   Video @relation("ToVideo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
  @@index([position])
}

model Caption {
  base_url         String  @id
  base_url_to_json Json?   @default("{}") // make sure to convert xml to string.
  video_id         String?
  language_code    String?
  video            Video?  @relation(fields: [video_id], references: [id])
  extra            Json?   @default("{}")
}

