generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  extra     Json?    @default("{}")
}

enum VideoType {
  VIDEO
  SHORT
}

model Video {
  id                  String      @id @default(cuid())
  title               String
  channel_id          String
  short_description   String?
  duration            Int         @default(0)
  view_count          String      @default("0")
  type                VideoType   @default(VIDEO)
  keywords            String[]    @default([])
  like_count          String      @default("0")
  category            String?
  extra               Json?       @default("{}")
  last_manual_fetch   DateTime    @default(now())
  available_qualities String[]    @default([])
  thumbnails          Json        @default("[]")
  sponsorblocks       Json        @default("[]")
  chapters            Chapter[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  dislike_count       String      @default("0")
  heatmap             Json?       @default("{}")
  captions            Caption[]
  creator             Creator     @relation(fields: [channel_id], references: [id])
  nextEdges           VideoNext[] @relation("FromVideo")
  prevEdges           VideoNext[] @relation("ToVideo")

  @@index([channel_id])
  @@index([type])
  @@index([createdAt])
  @@index([channel_id, type])
}

model Chapter {
  id       String  @id @default(cuid())
  title    String  @default("")
  start    Int
  end      Int
  extra    Json?   @default("{}")
  video    Video?  @relation(fields: [video_id], references: [id])
  video_id String?

  @@index([video_id])
}

model VideoNext {
  fromId    String
  toId      String
  position  Int?
  extra     Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      Video    @relation("FromVideo", fields: [fromId], references: [id], onDelete: Cascade)
  to        Video    @relation("ToVideo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
  @@index([position])
}

model Caption {
  base_url         String  @id
  base_url_to_json Json?   @default("{}")
  video_id         String?
  language_code    String?
  extra            Json?   @default("{}")
  video            Video?  @relation(fields: [video_id], references: [id])

  @@index([video_id])
}

model Creator {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  url                String
  vanity_channel_url String?
  avatars            Json?    @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  extra              Json?    @default("{}")
  Videos             Video[]
}
