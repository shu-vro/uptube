model Creator {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  url                String
  vanity_channel_url String?
  avatars            Json?    @default("[]")
  Videos             Video[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  extra              Json?    @default("{}")
}
