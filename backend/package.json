{
  "name": "backend-api",
  "version": "1.0.0",
  "description": "Backend API for the application",
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch --no-clear-screen src/server.ts",
    "dev:studio": "prisma studio",
    "check": "tsc --noEmit",
    "test": "vitest run --reporter verbose",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --env inline --drop debugger --sourcemap --outfile ./dist/server ./src/server.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^6.19.0",
    "@scalar/express-api-reference": "^0.8.22",
    "base64-js": "^1.5.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "fast-xml-parser": "^5.3.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1",
    "pino": "^9.9.0",
    "pino-caller": "^4.0.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.0",
    "swagger-jsdoc": "^6.2.8",
    "tweetnacl": "^1.0.3",
    "youtubei.js": "^16.0.1",
    "ytdl-core": "^4.11.5",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "pino-pretty": "^13.1.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15"
  },
  "keywords": [
    "api",
    "backend",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT"
}
