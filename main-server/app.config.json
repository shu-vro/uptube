{
  "appName": "Backend API",
  "version": "1.0.0",
  "port": 3000,
  "env": "development",
  "database": {
    "url": "postgres://user:password@localhost:5432/mydatabase"
  },
  "logger": {
    "level": "info",
    "prettyPrint": true
  },
  "cors": {
    "origin": "*",
    "methods": "GET,HEAD,PUT,PATCH,POST,DELETE",
    "preflightContinue": false,
    "optionsSuccessStatus": 204
  }
}